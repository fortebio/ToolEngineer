{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Forte Biotech brand tokens",
  "version": "1.0.0",
  "source": "Logo chuan FORTE BIOTECH 2000x1780 (2026-09-17): 5 tam giac + chu. Mau lay truc tiep tu file.",
  "logo": {
    "canvas": { "w": 2000, "h": 1780 },
    "shapes": [
      { "name": "top-right",   "color": "teal-700", "points": [[762, 117], [2000, 0], [762, 627]] },
      { "name": "left-top",    "color": "teal-500", "points": [[50, 547], [690, 117], [690, 880]] },
      { "name": "left-mid",    "color": "teal-500", "points": [[5, 630], [690, 1010], [5, 1330]] },
      { "name": "left-bottom", "color": "green-500", "points": [[95, 1442], [690, 1092], [690, 1780]] },
      { "name": "bottom-right","color": "mint-300", "points": [[762, 1402], [1290, 1362], [762, 1790]] }
    ],
    "wordmark": { "text": ["FORTE", "BIOTECH"], "color": "teal-500", "font": "Montserrat Bold (gan giong font goc)",
                  "box": { "forte": [790, 690, 1560, 890], "biotech": [790, 1040, 1870, 1240] } },
    "files": { "raster-208": "forte-logo-208.png", "vector-lvgl": "firmware/rapid4p/main/ui/ui_logo.c" }
  },
  "palette": {
    "teal-500":  { "hex": "#26C5CF", "role": "primary / brand / wordmark" },
    "teal-700":  { "hex": "#17A6BF", "role": "primary-dark: pressed, gradient start" },
    "green-500": { "hex": "#1BD1A5", "role": "success / done" },
    "mint-300":  { "hex": "#6FE6C3", "role": "accent-light: gradient end, highlights" },
    "on-brand":  { "hex": "#06262A", "role": "text on teal/green fills (>= 7.5:1)" },
    "amber-500": { "hex": "#FFB300", "role": "warning (not in logo; semantic)" },
    "red-500":   { "hex": "#EF5350", "role": "danger / positive test result (not in logo; semantic)" },
    "navy-950":  { "hex": "#0A1418", "role": "dark: background (teal-tinted near-black)" },
    "navy-900":  { "hex": "#10202A", "role": "dark: header, footer, dialog" },
    "navy-800":  { "hex": "#152A35", "role": "dark: card, chip, tile" },
    "navy-700":  { "hex": "#1F3A46", "role": "dark: border" },
    "navy-600":  { "hex": "#2A3F4C", "role": "dark: secondary button" },
    "text":      { "hex": "#F2F8F9", "role": "dark: primary text" },
    "muted":     { "hex": "#A9BCC4", "role": "dark: secondary text (9.5:1 on navy-950)" },
    "light-bg":  { "hex": "#F4FBFC", "role": "light: background (teal-tinted white)" },
    "light-card":{ "hex": "#FFFFFF", "role": "light: card" },
    "light-text":{ "hex": "#10202A", "role": "light: primary text" },
    "light-muted":{ "hex": "#4B5F6A", "role": "light: secondary text (6.8:1 on light-bg)" },
    "light-border":{ "hex": "#CFE3E8", "role": "light: border" }
  },
  "gradient": { "brand": ["#17A6BF", "#26C5CF", "#6FE6C3"], "note": "progress bars, hero accents; huong 'left to right' hoac 'top to bottom' theo cot phai cua logo" },
  "typography": {
    "family": "Montserrat (LVGL: lv_font_vimate_* = Montserrat + Viet; web/Flutter: Google Fonts Montserrat)",
    "scale": { "hero": 48, "title": 24, "body": 24, "small": 18, "tiny": 14 },
    "note": "LCD 4.3in xem o tam tay -> body 24 px; web/app dung 16/14 px theo chuan nen tang. `scale` = thang lcd-4.3in; thang khac o `scales` (2026-09-19)",
    "scales": {
      "lcd-4.3in": { "px": "800x480", "hero": 48, "title": 24, "body": 24, "small": 18, "tiny": 14, "icon": 24, "icon-sm": 18,
                     "header": 56, "footer": 96, "btn": 72, "gap": 12, "content-pad": 20, "radius": 14, "min-target": 72,
                     "note": "Rapid4P P4 (firmware/rapid4p ui_theme.h thang UI_SCALE_SMALL 0)" },
      "lcd-2.8in": { "px": "320x240", "hero": 24, "title": 18, "body": 18, "small": 14, "tiny": 14, "icon": 18, "icon-sm": 14,
                     "header": 32, "footer": 56, "btn": 44, "btn-list": 56, "btn-modal": 52, "gap": 6, "content-pad": 8, "radius": 8, "min-target": 44, "ext-click": 3,
                     "softkey": { "label": 18, "hold-hint": 14, "border-top": 4, "cell": [98, 50],
                                  "note": "3 o softkey thang hang 3 nut co XANH/DO/TRANG cua vo may Rapid; nhan 18 px co 14 neu dai; hanh dong can GIU ghi 'giu' 14 px tren nhan (2026-09-20, nong dan deo gang)" },
                     "note": "Rapid4P-S3 ES3N28P 2.8in ILI9341 (ui_theme.h UI_SCALE_SMALL 1): 44 px ~ 7,9 mm ~ 72 px tren 4.3in; so khe 24 px tu ha 18 neu tran o 57 px" }
    }
  },
  "spacing": { "base": 4, "gap": 12, "card-pad": 10, "content-pad": 20, "radius": { "btn": 14, "card": 14, "chip": 20, "dialog": 18 } },
  "touch": { "min-target": 72, "min-gap": 12, "press-transition-ms": 120, "note": "thang lcd-2.8in: min-target 44 (typography.scales)" },
  "contrast": "Moi cap chu/nen trong bang nay >= 4.5:1 (WCAG AA chu thuong); kiem lai bang system/brand/README.md#kiem-tuong-phan khi doi mau"
}
