diagram.json
jsonPara

# NOT docs/, test/ or tools/. Those three bare entries were added on 2026-08-07 and meant
# every NEW file under them was silently un-addable: a history note written into
# docs/history/ could not be committed without -f, which is a large part of why v2.4.3AT
# reached the team with no visible history. Already-tracked files were unaffected, so
# nothing ever failed loudly.
__pycache__/
*.pyc
