menu "Rapid4P Configuration"

    config RAPID4P_SERVER_BASE
        string "Engineer Server base URL"
        default "https://hub.fortebio.tech"
        help
            Engineer Server (server/). Máy gọi GET /ota/check và POST kết quả tại đây.
            Token Bearer KHÔNG nằm trong firmware: nhập qua portal SoftAP, lưu NVS.
            Local test: http://192.168.x.x:8080 (server/scripts/localtest.ps1).

    config RAPID4P_OTA_INTERVAL_SEC
        int "OTA check interval (seconds)"
        default 21600
        range 60 86400

    config RAPID4P_SCREEN_SLEEP_SEC
        int "Backlight off after idle (seconds, 0 = never)"
        default 300

    # Mỗi target đúng MỘT board (depends on IDF_TARGET_*) nên set-target tự chọn đúng board;
    # profile sdkconfig.defaults.<board> vẫn ghi CONFIG_RAPID4P_BOARD_*=y tường minh (registry_check
    # đọc dòng đó). Board = khoá sản phẩm: P4 → `rapid4p`, S3 → `rapid4p-s3` (system/products.yaml).
    choice RAPID4P_BOARD
        prompt "Hardware board"
        default RAPID4P_BOARD_P4_43LCD if IDF_TARGET_ESP32P4
        default RAPID4P_BOARD_S3_28LCD if IDF_TARGET_ESP32S3

        config RAPID4P_BOARD_P4_43LCD
            bool "FBT ESP32-P4C5 + 4.3in LCD ST7102 MIPI-DSI 480x800 (Rapid4P bring-up)"
            depends on IDF_TARGET_ESP32P4
            help
                Board tham chiếu Rapid4P (main/boards/board_esp32p4_43lcd.h,
                docs/HARDWARE-PINOUT.md). Bo cảm biến 5 slot cắm JP1.

        config RAPID4P_BOARD_S3_28LCD
            bool "AI-IoT VN ES3N28P: ESP32-S3 N16R8 + 2.8in LCD ILI9341 SPI 320x240 + touch FT6236G"
            depends on IDF_TARGET_ESP32S3
            help
                Board 2.8in (main/boards/board_esp32s3_28lcd.h, pinout theo firmware-vimate
                s3-28lcd da chay that). WiFi noi (khong ESP-Hosted). Chan bo cam bien 5 slot
                la DE XUAT — xem docs/HARDWARE-PINOUT.md.
    endchoice

    config RAPID4P_DEV_CONSOLE
        bool "Dev console on UART0 (ui/btn/heap commands)"
        default y
        help
            REPL esp_console trên UART0 để lái UI từ máy dev (scripts/uicmd.py) khi bring-up.
            TẮT ở bản phát hành: mở luôn crash/reboot/mem-dump của esp_hosted qua cổng USB.

    config RAPID4P_DIAG_ENABLE
        bool "Enable periodic diag heap log"
        default y

    config RAPID4P_DIAG_INTERVAL_SEC
        int "Diag interval (seconds)"
        default 60
        depends on RAPID4P_DIAG_ENABLE

endmenu
