  espressif/esp_lvgl_port:
    component_hash: fb6c1fdfe70d4ca39a035d63ca394a35f17ec84ce16ff98ecb13a54155d75da4
    dependencies:
    - name: idf
      require: private
      version: '>=5.2'
    - name: lvgl/lvgl
      registry_url: https://components.espressif.com
      require: public
      version: '>=8,<10'
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 2.8.0~1
  idf:
    source:
      type: idf
    version: 5.5.1
  lvgl/lvgl:
    component_hash: 7d82410747bbfb319531449749e940f440f8414f041f9eaba13f0d1dd7f58cdd
    dependencies:
    - name: espressif/freetype
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_FREETYPE} == True
      version: ^2.14.3
    - name: espressif/libjpeg-turbo
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_LIBJPEG_TURBO} == True
      version: ^3.1.1
    - name: espressif/libpng
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_LIBPNG} == True
      version: ^1.6.58
    - name: espressif/lz4
      registry_url: https://components.espressif.com
      require: private
      rules:
      - if: idf_version >=5.5 && $CONFIG{LV_USE_LZ4} == True && $CONFIG{LV_USE_LZ4_INTERNAL}
          == False
      version: ^1.10.0
    source:
      registry_url: https://components.espressif.com/
      type: service
    version: 9.6.0~1
