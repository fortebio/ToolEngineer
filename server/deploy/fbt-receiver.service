[Unit]
Description=FBT data receiver + read API (FastAPI)
After=network.target postgresql.service

[Service]
User=engineer
WorkingDirectory=/home/engineer/fbt_server
EnvironmentFile=/etc/fbt-receiver.env
ExecStart=/home/engineer/fbt_server/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
