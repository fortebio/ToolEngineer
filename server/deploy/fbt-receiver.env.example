# /etc/fbt-receiver.env — MẪU (không có giá trị thật). systemd EnvironmentFile của fbt-receiver.service.
# Ý nghĩa từng biến: server/app/config.py. File thật CHỈ nằm trên box, KHÔNG commit.
# tools/registry_check.py đọc file mẫu này để đối chiếu OTA_LEGACY_PRODUCT_BY_PREFIX với system/products.yaml.

# --- Xác thực -------------------------------------------------------------------------------
# Token thiết bị + user đọc (Bearer). Rỗng = từ chối hết (fail-closed).
RECEIVER_TOKEN=PASTE_RECEIVER_TOKEN
# Token CŨ còn chấp nhận trong lúc xoay (phân tách dấu phẩy). Bình thường để trống.
RECEIVER_TOKENS_OLD=
# Token nhân sự (root/admin): ghi OTA, /monitor, PUT /ate/limits. Rỗng = tắt (dùng chung RECEIVER_TOKEN).
OTA_ADMIN_TOKEN=PASTE_OTA_ADMIN_TOKEN

# --- Lưu trữ (file là nguồn chân lý; Postgres chỉ sessions/users) ---------------------------
FBT_DB=dbname=mydb connect_timeout=5
FBT_DATA_DIR=/home/engineer/fbt_server/data_plus
FBT_OTA_DIR=/home/engineer/fbt_server/ota
FBT_LOGS_DIR=/home/engineer/fbt_server/logs
FBT_ATE_DIR=/home/engineer/fbt_server/ate
FBT_WEB_DIR=/home/engineer/fbt_server/web

# --- Đa sản phẩm (kho OTA products/<product>/) -----------------------------------------------
# Máy KHÔNG khai ?product= (fleet ≤ v2.4.5) rơi vào sản phẩm này.
OTA_LEGACY_PRODUCT=rapidplus
# Máy không khai product nhưng mã máy có tiền tố → sản phẩm theo tiền tố. PHẢI khớp các sản phẩm
# `legacy_prefix_default: true` trong system/products.yaml (registry_check kiểm).
OTA_LEGACY_PRODUCT_BY_PREFIX=RE=reader,RPL=rapidplus
# Kho nào BẮT BUỘC ảnh có thẻ nhận dạng khi upload (FBTIMG1 nhúng, hoặc esp_app_desc_t của ảnh ESP-IDF).
# Danh sách khoá phân tách dấu phẩy; "1"/"true" = mọi kho; trống = tắt. Ảnh ESP-IDF (rapid4p) luôn có
# app_desc nên bật được ngay; kho rapidplus chờ fleet lên bản có FBTIMG1 (≥ v2.4.6).
OTA_REQUIRE_TAG=rapid4p
