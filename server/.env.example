# Sao chép file này thành `.env` rồi điền giá trị thật (KHÔNG commit .env).
#   cp .env.example .env

# Mật khẩu Postgres — đặt chuỗi mạnh.
POSTGRES_PASSWORD=change_this_postgres_password

# Token admin: app nhập ở Cài đặt → gửi header `Authorization: Bearer <ADMIN_TOKEN>`
# khi đọc dữ liệu (action=ids|runs|run). Xoay token = đổi ở đây + nhập lại trong app.
ADMIN_TOKEN=change_this_admin_token

# Key thiết bị: firmware gửi header `X-Device-Key: <DEVICE_KEY>` (hoặc ?key=) khi POST /ingest.
DEVICE_KEY=change_this_device_key

# === Public hóa bằng DuckDNS + mở port (hướng CHÍNH, miễn phí) ===
# Chạy: docker compose --profile duckdns up -d --build  (cần port-forward 80+443 ở router)
DUCKDNS_SUBDOMAIN=ten           # phần trước .duckdns.org (vd: fbtrapid)
DUCKDNS_TOKEN=                  # token lấy ở https://www.duckdns.org
PUBLIC_HOST=ten.duckdns.org     # Caddy xin cert HTTPS cho host này (để 'localhost' khi test cục bộ)

# === (Tùy chọn / nâng cao) Cloudflare Tunnel — CHỈ chạy được nếu có domain là zone trên Cloudflare ===
# LƯU Ý: domain free .eu.org KHÔNG add được vào Cloudflare gói Free (Error 1049). Muốn dùng tunnel phải
# có domain trả phí. Token: Zero Trust → Networks → Tunnels → Create. Chạy: `--profile tunnel`.
TUNNEL_TOKEN=
